{
  "name": "pdf-bench",
  "version": "0.1.0",
  "private": true,
  "description": "A local workbench for creating and inspecting PDFs.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && markdownlint-cli2",
    "test": "node --test"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.20.2"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    },
    "markdownlint": {
      "re2js": "2.8.7"
    }
  }
}
